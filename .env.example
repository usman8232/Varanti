# Copy to .env in the repo root OR backend/.env — never commit the real file.

# FastAPI
APP_NAME=Varanti
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins; empty = deny browser CORS in production
CORS_ORIGINS=http://localhost:3000

# Rate limits (OCR)
OCR_RATE_LIMIT_PER_MINUTE=10

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_RECEIPTS_BUCKET=receipts
SUPABASE_SERIALS_BUCKET=serial-labels

# Gemini Flash (Google AI Studio API key)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash


# Tesseract (leave empty to use PATH)
TESSERACT_CMD=
